# Nexus Tales — Environment Variables
# Copy to .env.local and fill in your values

# ===== Database (Vercel Postgres — free 1GB) =====
# Get these from: Vercel Dashboard → Storage → Create Postgres DB
DATABASE_URL="postgres://..."    # connection pooler URL
DIRECT_URL="postgres://..."      # direct URL (for `prisma migrate`)

# ===== NextAuth =====
NEXTAUTH_URL=https://novelhub.beauty
NEXT_PUBLIC_SITE_URL=https://novelhub.beauty
NEXTAUTH_SECRET=                 # openssl rand -base64 32

# ===== Google OAuth (唯一 OAuth 登录方式) =====
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== NowPayments (加密货币支付) =====
# https://nowpayments.io → Dashboard → API Keys
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=          # Store Settings → IPN Secret Key
NOWPAYMENTS_SANDBOX=false        # Set to "true" for test mode

# ===== Lemon Squeezy (信用卡支付) =====
# https://app.lemonsqueezy.com → Settings → API
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=    # Settings → Webhooks → Signing Secret

# ===== Google Analytics =====
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
