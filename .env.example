# Nexus Tales — Environment Variables
# Copy to .env.local and fill in your values

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://novelhub.beauty
NEXTAUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth — https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Twitter OAuth v2 — https://developer.twitter.com/en/portal
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Creem — https://creem.io/dashboard/developers
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
NEXT_PUBLIC_CREEM_PREMIUM_PRODUCT_ID=
NEXT_PUBLIC_CREEM_ULTIMATE_PRODUCT_ID=